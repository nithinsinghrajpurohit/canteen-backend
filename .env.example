# Copy this file to .env and fill in your real values. NEVER commit .env.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=smartcanteen

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Google OAuth client ID — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here

# Secret for signing login tokens — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
